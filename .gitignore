# Data is too large for GitHub — download it from the official sources (see README)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv.zip
*.zip
*.parquet

# Keep small result tables
!tables/*.csv

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# LaTeX build files (the .tex and .pdf are kept)
*.aux
*.log
*.out
*.toc
